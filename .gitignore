# ──────────────────────────────────────────────────────────────────
#  E-Notes - Root .gitignore
#  Covers both sub-projects:
#    • ENotes/            → Java 22 + Spring Boot + Maven (backend)
#    • E-Notes-Frontend/  → React 19 + Vite (frontend)
#  Each sub-project also has its own tailored .gitignore.
# ──────────────────────────────────────────────────────────────────

# ─── Sensitive files & environment variables ──────────────────────
# NEVER commit secrets. Keep keys in env vars or uncommitted files.
Google&GithubKey.txt
*.env
.env.*
!.env.example
*.local
*.pem
*.key
*.crt

# ─── Screenshots folder ───────────────────────────────────────────
screenshots/

# ─── Java / Maven (Backend) ───────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
HELP.md
*.log

# ─── Node / React / Vite (Frontend) ───────────────────────────────
node_modules/
dist/
dist-ssr/
coverage/
.nyc_output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Logs ─────────────────────────────────────────────────────────
logs/
*.log

# ─── IDE / Editor ─────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.idea_modules/
.vscode/*
!.vscode/extensions.json
.settings/
.classpath
.project
.factorypath
.apt_generated
.springBeans
.sts4-cache
nbproject/private/
nbbuild/
nbdist/
nb-gradle/
build/

# ─── OS ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── Misc / Editor backup files ───────────────────────────────────
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig
*~
*.rej
